{
  "name": "commonplace-cli",
  "version": "0.1.0",
  "description": "Commonplace CLI: turns YouTube videos into recap preview links for the commonplace-youtube-recap agent skill",
  "license": "MIT",
  "type": "module",
  "bin": {
    "commonplace": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "youtube-dl-exec": "^3.1.17",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "@commonplace/video-util": "*",
    "vitest": "^5.0.2"
  }
}
