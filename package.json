{
  "name": "video-project",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @video-recap/api\" \"npm run dev -w @video-recap/web\"",
    "herdr": "./herdr-dev.sh",
    "dev:herdr": "./herdr-dev.sh",
    "dev:api": "npm run dev -w @video-recap/api",
    "dev:web": "npm run dev -w @video-recap/web",
    "build": "npm run build -w @video-recap/api && npm run build -w @video-recap/web",
    "check": "npm run check -w @video-recap/api && npm run check -w @video-recap/web",
    "db:generate": "npm run db:generate -w @video-recap/api",
    "db:migrate": "npm run db:migrate -w @video-recap/api",
    "db:seed": "npm run db:seed -w @video-recap/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w @video-recap/api"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "drizzle-orm": "^0.45.3",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
